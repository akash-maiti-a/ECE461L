# Cluster all three databases use, unless the URIs below are set.
# MONGODB_URI (the name Atlas uses) works too. A database name in the URI is
# ignored: accounts go to USERS_DB_NAME, projects to PROJECTS_DB_NAME, and
# hardware sets and checkout history to HARDWARE_DB_NAME.
MONGO_URI=mongodb://localhost:27017
USERS_DB_NAME=haas_users
PROJECTS_DB_NAME=haas_projects
HARDWARE_DB_NAME=haas_hardware
# Uncomment to put a database on its own cluster.
# USERS_MONGO_URI=mongodb+srv://user:pass@users-cluster.example.net
# PROJECTS_MONGO_URI=mongodb+srv://user:pass@projects-cluster.example.net
# HARDWARE_MONGO_URI=mongodb+srv://user:pass@hardware-cluster.example.net
SECRET_KEY=change-me
# Encrypts user IDs in the database. Defaults to SECRET_KEY. Never change it
# once accounts exist, or they can't sign in.
# USERID_ENCRYPTION_KEY=another-long-random-string
PORT=5001
# USE_MOCK_DB=1
# Production only (the cloud host serves over HTTPS):
# SESSION_COOKIE_SECURE=1
# Where the React build is. Defaults to ../creator-eaas/build.
# FRONTEND_BUILD_DIR=/app/creator-eaas/build
