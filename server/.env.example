# Cluster both databases use, unless the two URIs below are set.
# MONGODB_URI (the name Atlas uses) works too. A database name in the URI
# is ignored: accounts go to USERS_DB_NAME and projects go to PROJECTS_DB_NAME.
MONGO_URI=mongodb://localhost:27017
USERS_DB_NAME=haas_users
PROJECTS_DB_NAME=haas_projects
# Uncomment to put accounts and projects on different clusters.
# USERS_MONGO_URI=mongodb+srv://user:pass@users-cluster.example.net
# PROJECTS_MONGO_URI=mongodb+srv://user:pass@projects-cluster.example.net
SECRET_KEY=change-me
PORT=5001
# USE_MOCK_DB=1
